# Copy this file to ".env" and fill in real values. NEVER commit .env to GitHub.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). The database name in the URI is used as-is.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Optional: all portal collections get this prefix so they never mix with other apps in the same database
COLLECTION_PREFIX=ep_

# JWT signing key – at least 32 random characters. Generate one with:  npm run gen:secret
JWT_SECRET=<paste-output-of-npm-run-gen:secret>
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

PORT=5000
NODE_ENV=development
# Timezone used to decide "today" for daily reports
TZ_NAME=Asia/Kolkata
# Frontend URL(s) allowed to call the API, comma separated. Use your domain in production, * only for local testing.
CORS_ORIGIN=*
